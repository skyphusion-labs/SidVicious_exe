# SidVicious_exe environment template. Copy to .env (local) or stacks/.env (Docker).
# Never commit the filled-in copy; .env and stacks/.env are gitignored.

# --- Discord ---
DISCORD_TOKEN=                                 # required: bot token from the Developer Portal
DISCORD_CHANNEL_IDS=                           # optional: comma-separated channel IDs (empty = DMs + @mentions)
DISCORD_MODEL=anthropic/claude-sonnet-4-6      # optional: chat model
DISCORD_HISTORY=20                             # optional: rolling history depth in exchange pairs

# --- Chat ---
# Gateway: set CF_API_TOKEN (and CF_ACCOUNT_ID, or CF_GATEWAY_ENDPOINT).
# The Run token is sent as cf-aig-authorization. A stored gateway key or
# Unified Billing supplies the Anthropic credential. If ANTHROPIC_API_KEY is
# also set, that key is sent as x-api-key.
# Direct: set ANTHROPIC_API_KEY and leave CF_API_TOKEN empty. Chat calls
# api.anthropic.com. Images still need the Cloudflare token.
# ANTHROPIC_API_KEY=
# --- Cloudflare ---
# Workers AI images (@cf/*) go through the search Worker AI binding when SEARCH_* is set.
# Direct api.cloudflare.com /ai/run needs a real account API token with Workers AI
# (AIG Run tokens return 401 on that path).
CF_ACCOUNT_ID=                                 # required for the gateway path (+ images without search worker)
CF_API_TOKEN=                                  # AI Gateway Run token for chat (alias: CF_AIG_TOKEN)
CF_AIG_GATEWAY_ID=skyphusion-llm               # optional: AI Gateway name
# CF_GATEWAY_ENDPOINT=                         # optional: full compat URL override

# --- D1 session persistence (optional) ---
CF_D1_DATABASE_ID=                             # optional: D1 database ID (required with token for sessions)
# CF_D1_TOKEN=                                 # optional: D1 token if different from CF_API_TOKEN

# --- Search worker (required for search tools + recommended for @cf/* images) ---
SEARCH_WORKER_URL=                             # e.g. https://sidvicious-search.<subdomain>.workers.dev
SEARCH_SECRET=                                 # shared secret for X-Search-Secret header

# --- Ollama fallback (optional; omit CF_API_TOKEN to enable, chat only, no images) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# DISCORD_MODEL=qwen3:8b
